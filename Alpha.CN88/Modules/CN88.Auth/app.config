<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
        <section name="Fanex.Caching" type="Fanex.Caching.Configuration.CacheSettings, Fanex.Caching" />
    </configSections>
  
  
  <runtime>
  
  
          <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
  
  
                  <dependentAssembly>
  
  
                          <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
  
  
                          <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
  
  
                  </dependentAssembly>
  
  
                  <dependentAssembly>
  
  
                          <assemblyIdentity name="Couchbase" publicKeyToken="05e9c6b5a9ec94c2" culture="neutral" />
  
  
                          <bindingRedirect oldVersion="0.0.0.0-1.2.7.0" newVersion="1.2.7.0" />
  
  
                  </dependentAssembly>
  
  
                  <dependentAssembly>
  
  
                          <assemblyIdentity name="Enyim.Caching" publicKeyToken="05e9c6b5a9ec94c2" culture="neutral" />
  
  
                          <bindingRedirect oldVersion="0.0.0.0-1.2.7.0" newVersion="1.2.7.0" />
  
  
                  </dependentAssembly>
  
  
          </assemblyBinding>
  
  
  </runtime>
<Fanex.Caching cacheType="Fanex.Caching.Memory.MemoryCache, Fanex.Caching">
        <connectionSettings>
            <add name="CompactOnMemoryPressure" value="true" />
            <add name="ExpirationScanFrequency" value="1" />
        </connectionSettings>
    </Fanex.Caching></configuration>