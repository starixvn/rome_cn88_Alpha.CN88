@model Alpha.CN88.Site.ViewModels.Default.MenuBarViewModel

<section id="main-menu-tab" class="mainmenu-container">
    <ul class="list-menu" id="main-menu-items">
        <li class="menu-item" id="menu-back">
            <a class="txt-item"><span class="icon-chevron-double-left"></span></a>
        </li>
        @foreach (var menuItem in Model.MenuItems)
        {
            if (menuItem.VisibileSubMenus.Any())
            {
                <li class="menu-item @(menuItem.ShowSubMenus ? "active" : string.Empty)" id="menu-@(menuItem.ResourceKey.ToUpper())">
                    <a class="txt-item menu-opener parent-menu @(menuItem.ShowSubMenus ? "active" : string.Empty)" href="javascript:void(0);">@Html.Raw(menuItem.DisplayName)</a>
                </li>
            }
            else
            {
                <li class="menu-item" id="menu-@(menuItem.ResourceKey.ToUpper())">
                    <a class="txt-item menu-opener parent-menu redirect-item" href="@menuItem.Link" target="main">@menuItem.DisplayName</a>
                </li>
            }
        }
    </ul>
    @foreach (var menuItem in Model.MenuItems)
    {
        if (menuItem.VisibileSubMenus.Any())
        {
            <ul class="sub-menu @(menuItem.ShowSubMenus ? "" : "display-none")" data-main-menu="menu-@(menuItem.ResourceKey.ToUpper())">
                @foreach (var subMenuItem in menuItem.VisibileSubMenus)
                {
                    <li class="sub-menu-item @(subMenuItem.Status.Disabled?"disabled-menu":string.Empty)">
                        <a href="@subMenuItem.Link" target="main" class="redirect-item" id="sub-menu-@(subMenuItem.ResourceKey.ToUpper())">
                            @subMenuItem.DisplayName
                            @Html.Raw(subMenuItem.IsBeta ? "<span class=\"beta-version\">" + SitemapLabels.Beta + "</span>" : string.Empty)
                        </a>
                    </li>
                }
                <li class="sub-menu-item pull-right btn-item"><button class="btn-secondary">Wager Monitoring Console</button></li>
            </ul>
            
        }
    }
</section>