@using Alpha.CN88.Configurations;
@model Alpha.CN88.Site.ViewModels.Default.IndexViewModel
@if (Model.IsDevice)
{
    <div class="menubar-mobile">
        <div id="hamburger-container" class="hamburger-container">
            <div class="hamburger-icon" id="hamburgerIcon">
                <span class="line line-1"></span>
                <span class="line line-2"></span>
                <span class="line line-3"></span>
            </div>
        </div>
        <div class="page-title">Home</div>

        <div class="dropdown general-info">
            <a href="javascript:;" data-target="#" class="dropdown-toggle" data-toggle="dropdown">
                <span class="icon-more"></span>
            </a>
            <ul class="dropdown-menu">
                @if (Model.IsNotHeadline)
                {
                    <li class="header-item online-member">
                        <a href="#"><span>@Resources.OnlineMembers:</span><span id="numberOnlineMember"> @HtmlHelpers.FormatNumber(Model.OnlineMember)</span></a>
                    </li>
                }
                <li class="@(Model.IsSelectedLanguage("en-US") ? "active":string.Empty) en-US"><a class="changelanguage-link" data-value="en-US"><span class="flag flag-en" data-language-code="en-US"></span> English</a></li>
                <li class="@(Model.IsSelectedLanguage("zh-Hans") ? "active":string.Empty) zh-Hans"><a class="changelanguage-link" data-value="zh-Hans"><span class="flag flag-cn" data-language-code="zh-Hans"></span> 简体</a></li>
                <li class="@(Model.IsSelectedLanguage("zh-TW") ? "active":string.Empty) zh-TW"><a class="changelanguage-link" data-value="zh-TW"><span class="flag flag-tw" data-language-code="zh-TW"></span> 繁體</a></li>
            </ul>
        </div>
    </div>

    <div class="username-mobile">
        <div class="dropdown">
            @Html.Partial("UserPanel")
        </div>
    </div>
}
else
{
    <section class="header-nav" id="header-nav">
        <input type="hidden" id="IsNotHeadLine" value="@(Model.IsNotHeadline?1:0)" />
        <input type="hidden" id="IntervalToGetTotalOnlineMember" value="@AppSettings.IntervalToGetTotalOnlineMember" />
        <ul class="header-left"></ul>
        <ul class="header-right">

            @if (Model.IsNotHeadline)
            {
            <li class="header-item online-member">
                <span>@Resources.OnlineMembers:</span><span id="numberOnlineMember"> @HtmlHelpers.FormatNumber(Model.OnlineMember)</span>
            </li>
            }
            <li class="header-item dropdown language">
                @Html.Action("List", "Language")
            </li>
            <li class="header-item dropdown header-custname">
                @Html.Partial("UserPanel")
            </li>
        </ul>
    </section>
}

