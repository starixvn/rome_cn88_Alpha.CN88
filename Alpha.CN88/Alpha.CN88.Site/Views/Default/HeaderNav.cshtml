@model Alpha.CN88.Site.ViewModels.Default.IndexViewModel
<section class="header-nav" id="header-nav">
    <ul class="header-left">
        <li class="header-item dropdown language">
            @Html.Action("List", "Language")
        </li>
        <li class="header-item online-member">
            <span>@Resources.OnlineMembers: @Model.OnlineMember</span>
        </li>
    </ul>
    <ul class="header-right">
        <li class="header-item" id="lnk-new-url">
            @Resources.NewURL
        </li>
        <li class="header-item" id="lnk-live-chat">
            <span class="icon-chat"></span>@Resources.LiveChat
        </li>
        <li class="header-item" id="lnk-contact-us">
            @Resources.ContactUs
        </li>
        <li class="header-item" id="lnk-personal-announcement"><span class="icon-bell"></span></li>
        <li class="header-item dropdown">
            <a href="javascript:;" data-target="#" class="dropdown-toggle" data-toggle="dropdown">
                @Model.CustName
                <span class="icon-chevron-down"></span>
            </a>
            <ul class="dropdown-menu">
                <li><a id="lnk-my-setting">@Resources.MySetting</a></li>
                <li><a id="lnk-password-recovery">@Resources.PasswordRecorvery</a></li>
                <li><a id="lnk-change-password">@Resources.ChangePassword</a></li>
                <li><a id="lnk-logout">@Resources.Logout</a></li>
            </ul>
        </li>
    </ul>
</section>