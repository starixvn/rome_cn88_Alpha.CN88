@model Alpha.CN88.Site.ViewModels.Default.IndexViewModel
<section class="header-nav" id="header-nav">
    <ul class="header-left"></ul>
    <ul class="header-right">
        <li class="header-item dropdown language">
            @Html.Action("List", "Language")
        </li>
        <li class="header-item online-member">
            <span>@Resources.OnlineMembers: @HtmlHelpers.FormatNumber(Model.OnlineMember)</span>
        </li>
        <li class="header-item" id="lnk-personal-announcement"><a href="@Model.PersonalMessagePath" target="main"><span class="icon-bell"></span></a></li>
        <li class="header-item dropdown header-custname">
            <a href="javascript:;" data-target="#" class="dropdown-toggle" data-toggle="dropdown">
                @Model.CustName
                <span class="icon-chevron-down"></span>
            </a>
            <ul class="dropdown-menu">             
                <li><a id="lnk-change-password">@Resources.ChangePassword</a></li>
                <li><a id="lnk-security-code">@Resources.ChangeSecurityCode</a></li>
                <li><a id="lnk-logout">@Resources.Logout</a></li>
            </ul>
        </li>
    </ul>
</section>