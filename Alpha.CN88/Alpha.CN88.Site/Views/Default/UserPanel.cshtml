<a href="javascript:;" data-target="#" class="dropdown-toggle" data-toggle="dropdown">
    @Model.CustName
    <span class="icon-chevron-down"></span>
</a>
<ul class="dropdown-menu">
    <li><a id="lnk-change-password">@Resources.ChangePassword</a></li>
    <li><a id="lnk-security-code">@Resources.ChangeSecurityCode</a></li>
    <li class="@(Model.IsSelectedLanguage("en-US") ? "active":string.Empty) en-US hide-desktop"><a class="changelanguage-link" data-value="en-US"><span class="flag flag-en" data-language-code="en-US"></span> English</a></li>
    <li class="@(Model.IsSelectedLanguage("zh-Hans") ? "active":string.Empty) zh-Hans hide-desktop"><a class="changelanguage-link" data-value="zh-Hans"><span class="flag flag-cn" data-language-code="zh-Hans"></span> 简体</a></li>
    <li class="@(Model.IsSelectedLanguage("zh-TW") ? "active":string.Empty) zh-TW hide-desktop"><a class="changelanguage-link" data-value="zh-TW"><span class="flag flag-tw" data-language-code="zh-TW"></span> 繁體</a></li>
    <li><a id="lnk-logout">@Resources.Logout</a></li>
</ul>