<a href="javascript:;" data-target="#" class="dropdown-toggle" data-toggle="dropdown">
    @Model.CustName
    <span class="icon-chevron-down"></span>
</a>
<ul class="dropdown-menu">
    @if (Model.MySettingPath.Length != 0)
    {
        <li><a id="lnk-my-setting" href="@Model.MySettingPath" target="main">@Resources.MySettings</a></li>
    }
    <li><a id="lnk-change-password">@Resources.ChangePassword</a></li>
    <li><a id="lnk-security-code">@Resources.ChangeSecurityCode</a></li>
    <li class="language hide-desktop">
        <a href="#">Language</a>
        <ul class="list-lang">
            <li class="@(Model.IsSelectedLanguage("zh-Hans") ? "active":string.Empty) zh-Hans"><span class="flag flag-cn" data-language-code="zh-Hans"></span> <a class="changelanguage-link" data-value="zh-Hans">简体版</a></li>
            <li class="@(Model.IsSelectedLanguage("zh-TW") ? "active":string.Empty) zh-TW"><span class="flag flag-tw" data-language-code="zh-TW"></span> <a class="changelanguage-link" data-value="zh-TW">繁體版</a></li>
            <li class="@(Model.IsSelectedLanguage("en-US") ? "active":string.Empty) en-US"><span class="flag flag-en" data-language-code="en-US"></span> <a class="changelanguage-link" data-value="en-US">English</a></li>            
        </ul>
    </li>    
    <li><a id="lnk-logout">@Resources.Logout</a></li>
</ul>