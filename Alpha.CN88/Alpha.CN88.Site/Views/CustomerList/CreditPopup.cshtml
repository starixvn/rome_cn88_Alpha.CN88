@model CreditRangeViewModel

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>@(ViewBag.Title ?? "Alpha - CN88")</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />

	@section Styles {
		@StaticResources.AssetStyles.Render("/bundles/common/common")
		@StaticResources.RenderStyles("~/assets/bundles/credit")
	}
</head>
<body>
	<div class="popup-modal">
		<div class="col-xs-12 hidden msg" id="error-message"></div>
		<div class="form-group col-xs-12">
			<div class="col-xs-3">
				@Resources.UsedCredit
			</div>
			<div class="col-xs-9">
				<span>@((Model.CustLevel.IsMemberLevel() ? Model.CreditModel.BetCredit : Model.CreditModel.UsedCredit).ToString("N0"))</span>
			</div>
		</div>
		<div class="form-group col-xs-12">
			<div class="col-xs-3">@Resources.Credit</div>
			<div class="col-xs-4">
				<input class="textbox" id="credit" />
			</div>
			<div class="col-xs-4 credit-range">
				[@Model.CreditModel.MinCredit.ToString("N0"); @Model.CreditModel.MaxCredit.ToString("N0")]
			</div>
		</div>
		<div class="col-xs-10 row-info popup-bottom list-button">
			<button type="button" class="btn-submit">@Resources.Save</button>
			<button type="button" class="btn-cancel">@Resources.Cancel</button>
		</div>
	</div>

	@Html.Hidden("MinCredit", Model.CreditModel.MinCredit)
	@Html.Hidden("MaxCredit", Model.CreditModel.MaxCredit)
	@Html.Hidden("CustId", Model.CustId)
	@Html.Hidden("UpdateSuccessfully", Resources.UpdateSuccessfully)
	@Html.AntiForgeryToken()

	@section Scripts {
		@StaticResources.RenderScripts("~/assets/bundles/customer-list/popup/credit-popup")
		@StaticResources.AssetScripts.Render("/bundles/common/cleave")
	}
</body>
</html>