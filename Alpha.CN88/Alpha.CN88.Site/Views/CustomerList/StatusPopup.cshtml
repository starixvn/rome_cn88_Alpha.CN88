@model StatusPopupViewModel
@using Alpha.CN88.Constants

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>@(ViewBag.Title ?? "Alpha - CN88")</title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />

	@section Styles {
		@StaticResources.AssetStyles.Render("/bundles/common/common")
		@StaticResources.RenderStyles("~/assets/bundles/credit")
	}
</head>
<body>
	<div class="popup-modal">
		<div class="col-xs-12 hidden msg" id="error-message"></div>
		<div class="form-group col-xs-12">
			<div class="col-xs-3 status-label">
				@Resources.Status
			</div>
			<div class="col-xs-7">
				<select id="dropdown-status" class="dropdown-status">
					<option value="@CustomerStatus.Open">@Resources.Open</option>
					<option value="@CustomerStatus.Closed">@Resources.Closed</option>
					<option value="@CustomerStatus.Suspended">@Resources.Suspended</option>
				</select>
			</div>
		</div>
		<div class="col-xs-8 row-info popup-bottom list-button">
			<button type="button" class="btn-submit">@Resources.Save</button>
			<button type="button" class="btn-cancel">@Resources.Cancel</button>
		</div>
	</div>

	@section Scripts {
		@StaticResources.RenderScripts("~/assets/bundles/customer-list/popup/status-popup")
	}
</body>
</html>


