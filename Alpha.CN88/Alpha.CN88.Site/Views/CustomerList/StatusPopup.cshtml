@model StatusPopupViewModel
@using Alpha.CN88.Constants

@section Styles {
	@StaticResources.AssetStyles.Render($"/bundles/site-cn88/tab-super")
}

<div class="container">
	<form role="form">
		<div class="form-group">
			<label>@Resources.Status</label>
			<select id="dropdown-status" class="dropdown-status">
				<option value="@CustomerStatus.All">@Resources.All</option>
				<option value="@CustomerStatus.Open">@Resources.Open</option>
				<option value="@CustomerStatus.Closed">@Resources.Closed</option>
				<option value="@CustomerStatus.Suspended">@Resources.Suspended</option>
			</select>
		</div>
		<div class="form-group row text-right">
			<div class="col-xs-6">
				<button type="button" class="btn btn-secondary" data-dismiss="modal">@Resources.Cancel</button>
			</div>
			<div class="col-xs-1">
				<button type="button" class="btn btn-primary" id="save-btn">@Resources.Save</button>
			</div>
		</div>
	</form>
</div>
