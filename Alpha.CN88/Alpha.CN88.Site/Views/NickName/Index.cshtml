@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>NickName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommon("/bundles/site-cn88/default")
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      @StaticResources.AssetScripts.RenderCommon("/bundles/common/support-IE8")
    <![endif]-->
</head>
<body>
    @using (Html.BeginForm("Create", "NickName", FormMethod.Post, new { id = "frmNickName" }))
    {
        @Html.AntiForgeryToken()
        <div>Please create a login ID that you can easily remember.</div>
        <div class="rules">
            <ul>
                <li>Your login ID must be between 6 to 12 alphanumeric characters with at least 2 capital (A-Z) or lowercase letters (a-z) and at least 1 numeric character (0-9).</li>
                <li>Your login ID must not contain any spaces.</li>
            </ul>
        </div>
        <label for="nickname">Login ID</label>
        <input type="text" id="nickname" name="nickname" autocomplete="off" />
        <div class="note">
            Note: Once successfully created, the login ID cannot be modified. Please use the newly created login ID on your next login. The original agent user code will only be used for identification purposes.
        </div>
        <button type="button">Cancel</button>
        <button type="submit">Submit</button>
    }
    
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-cn88/default")
    @StaticResources.RenderScripts("~/assets/bundles/nickname/create-nickname")
</body>
</html>