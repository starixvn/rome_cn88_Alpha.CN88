@using CN88.Auth.AppResources
@model Alpha.CN88.Site.ViewModels.NickName.CreateNickNameViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    <title>@AuthResource.NickName</title>
    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
      @StaticResources.AssetScripts.RenderCommon("/bundles/common/support-IE8")
    <![endif]-->
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.RenderCommon("/bundles/site-cn88/security")
    @StaticResources.RenderStyles("~/assets/bundles/security/create-nickname")
</head>
<body>
    <div class="block">
        <div class="title-box">@AuthResource.NickNameTitle</div>
        @using (Html.BeginForm("Index", "NickName", FormMethod.Post, new { id = "frmNickName", @class = "form-security form-create-login" }))
        {
            @Html.AntiForgeryToken()
            <div id="message-container">
                @if (Model.Result?.IsFail == true)
                {
                    <div class="msg msg-error">@Model.Result.Message</div>
                }
            </div>
            <div class="note-txt">@AuthResource.NickNameStatement</div>
            <div class="rules">
                <div class="note-txt">@AuthResource.Rules:</div>
                <ol class="list-rules">
                    <li id="nickNameRule1">@AuthResource.NickNameRule1</li>
                    <li>@AuthResource.NickNameRule2</li>
                </ol>
            </div>
            <div class="rowlg">
                <label for="nickName" class="lb-title">@AuthResource.NickName</label>
                <input type="text" class="txt" id="nickName" name="NickName" autocomplete="off" maxlength="15" />
            </div>
            <div class="note note-txt">
                <span>@AuthResource.Note:</span> @AuthResource.NickNameNote
            </div>
            
            <div  class="list-button">
                <button type="button" class="btn-cancel" id="buttonBack">@AuthResource.Back</button>
                <button type="submit" class="btn-submit">@AuthResource.Submit</button>
            </div>
        }
    </div>
    @Html.Hidden("mainRootPath", Model.MainRootPath)
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-cn88/default")
    @StaticResources.RenderScripts("~/assets/bundles/nickname/create-nickname")
</body>
</html>