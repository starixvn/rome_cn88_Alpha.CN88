@{
    Layout = "~/Views/Help/Troubleshooting/_Layout.cshtml";
}
<div class="content-item">
    <a class="btn btn-back" href="@Url.Action("Troubleshooting", "Help")"><span class="icon-chevron-down"></span> 返回</a>
    <div class="title">清除瀏覽器的緩存</div>

    <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
        <div class="panel panel-default">
            <div class="panel-heading" role="tab" id="headingOne">
                <h4 class="panel-title">
                    <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        谷歌瀏覽器
                    </a>
                </h4>

            </div>
            <div id="collapseOne" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingOne">
                <div class="panel-body">
                    <div class="step">
                        <img src="~/assets/styles/images/help/cache_google01_cn.jpg" alt="cache-gg-01" />
                        <span>
                            <b>1.</b> 點擊右上選項. <br />
                            <b>2.</b> 點選 ‘工具’ - ‘清除瀏覽數據’.
                        </span>

                    </div>
                    <div class="step">
                        <img src="~/assets/styles/images/help/cache_google02_cn.jpg" alt="cache-gg-02" />
                        <span><b>3.</b> 全部勾選後點擊 ‘清除瀏覽數據’.</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading" role="tab" id="headingTwo">
                <h4 class="panel-title">
                    <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        IE瀏覽器
                    </a>
                </h4>

            </div>
            <div id="collapseTwo" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingTwo">
                <div class="panel-body">
                    <div class="step">
                        <img src="~/assets/styles/images/help/cache_ie01_cn.jpg" alt="cache-ie-01" />
                        <span>
                            <b>1.</b> 開啟 ‘Internet 選項’. <br />
                        </span>

                    </div>
                    <div class="step">
                        <img src="~/assets/styles/images/help/cache_ie02_cn.jpg" alt="cache-ie-02" />
                        <span><b>2.</b> 點擊 ‘刪除’.</span>
                    </div>
                    <div class="step">
                        <img src="~/assets/styles/images/help/cache_ie03_cn.jpg" alt="cache-ie-03" />
                        <span>
                            <b>3.</b> 勾選全部項目. <br />
                            <b>4.</b> 點擊 ‘刪除’.
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading" role="tab" id="headingThree">
                <h4 class="panel-title">
                    <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        EDGE瀏覽器
                    </a>
                </h4>

            </div>
            <div id="collapseThree" class="panel-collapse collapse" role="tabpanel" aria-labelledby="headingThree">
                <div class="panel-body">
                    <div class="step">
                        <img src="~/assets/styles/images/help/cache_edge01_cn.jpg" alt="cache-ed-01" />
                        <span>
                            <b>1.</b> 開啟 ‘設置’. <br />
                        </span>

                    </div>
                    <div class="step">
                        <img src="~/assets/styles/images/help/cache_edge02_cn.jpg" alt="cache-ed-02" />
                        <span><b>2.</b> 點擊 ‘選擇要清除的內容’.</span>
                    </div>
                    <div class="step">
                        <img src="~/assets/styles/images/help/cache_edge03_cn.jpg" alt="cache-ed-03" />
                        <span>
                            <b>3.</b> 勾選 ‘緩存的數據和文件’. <br />
                            <b>4.</b> 點擊 ‘刪除’.
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>