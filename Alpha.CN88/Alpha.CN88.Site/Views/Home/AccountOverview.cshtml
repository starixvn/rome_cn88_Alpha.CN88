@using Alpha.CN88.Site.ViewModels.Home
@model AccountOverviewViewModel
<table class="tbl-style2">
    <thead>
        <tr>
            <th colspan="2">@Resources.AccountOverview</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Resources.Credits</td>
            <td class="text-right">@Model.Credits</td>
        </tr>
        <tr>
            <td>@Resources.CreditBalance</td>
            <td class="text-right">@Model.CreditBalance</td>
        </tr>
        <tr>
            <td>@Resources.NewMemberForThisPeriod</td>
            <td class="text-right">@Model.NewMembers</td>
        </tr>
        <tr>
            <td>@Resources.YourLastLogin</td>
            <td class="text-right">@Model.LastLoginDateStr</td>
        </tr>
        <tr>
            <td>@Resources.PasswordLastChangedOn</td>
            <td class="text-right">@Model.LastPasswordChangedDateStr</td>
        </tr>
    </tbody>
</table>