@using Alpha.CN88.Site.ViewModels.Home
@model GeneralAnnouncementViewModel
<table class="tbl-style2">
    <thead>
        <tr>
            <th colspan="2">@Resources.Last5GeneralAnnouncement</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model.Announcements)
        {
        <tr>
            <td class="text-center col-date"><span class="date-box">@a.AffectedDateStr</span></td>
            <td>@Html.Raw(a.Content)</td>
        </tr>
        }
        
    </tbody>
    <tfoot>
        <tr>
            <td colspan="2" class="text-center">
                <span id="view-general-announcement" class="view-more" data-target="@Model.GeneralAnnouncementPath">@Resources.ViewMore</span>
            </td>
        </tr>
    </tfoot>
</table>