@using Alpha.CN88.Models.Home
@model StatusSummaryReport
<table class="tbl-style2 status-summary">
    <thead>
        <tr>
            <th>@Resources.StatusSummary</th>
            <th class="text-center">@Resources.Active</th>
            <th class="text-center">@Resources.Inactive</th>
            <th class="text-center">@Resources.Suspended</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.StatusSummary)
        {
            <tr>
                <td>@s.Name</td>
                @HtmlHelpers.RenderNumberCell(s.Active, "text-center status-active")
                @HtmlHelpers.RenderNumberCell(s.Inactive, "text-center status-inactive")
                @HtmlHelpers.RenderNumberCell(s.Suspened, "text-center status-suspended")
            </tr>
        }
    </tbody>
    <tfoot class="tfoot-bg">
        <tr>
            <td class="text-uppercase">@Resources.Total</td>
            @HtmlHelpers.RenderNumberCell(Model.Total.Active, "text-center status-active")
            @HtmlHelpers.RenderNumberCell(Model.Total.Inactive, "text-center status-inactive")
            @HtmlHelpers.RenderNumberCell(Model.Total.Suspened, "text-center status-suspended")
        </tr>
    </tfoot>
</table>