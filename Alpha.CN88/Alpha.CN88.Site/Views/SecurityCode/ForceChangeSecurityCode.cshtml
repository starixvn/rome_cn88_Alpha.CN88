@using CN88.Auth.AppResources
@model Alpha.CN88.Site.ViewModels.SecurityCode.ForceChangeSecurityCodeViewModel
@{
    Layout = "~/Views/SecurityCode/Shared/_Layout.cshtml";
    ViewBag.Title = AuthResource.SecurityCode;
}
@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles/site-cn88/security")
    @StaticResources.RenderScripts("~/assets/bundles/securitycode/change-securitycode")
}
<div class="block">
    <div class="title-box">@AuthResource.SecurityCode</div>
    @using (Html.BeginForm("ForceChangeSecurityCode", "SecurityCode", FormMethod.Post, new { id = "formSecurityCode", @class = "form-security form-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        <div class="rules">
            <p>@string.Format(AuthResource.SecurityCodeShower, Model.CustName)</p>
            <ul>
                <li>@AuthResource.SecurityCodeRule1</li>
                <li>@AuthResource.SecurityCodeRule2</li>
            </ul>
        </div>
        <div class="rowlg help-rules">
            <label class="lb-title" for="oldSecurityCode">@AuthResource.OldSecurityCode</label>
            <input type="password" autocomplete="off" class="txt" name="OldSecurityCode" id="oldSecurityCode" maxlength="6" />
        </div>
        <div class="rowlg">
            <label class="lb-title" for="securityCode">@AuthResource.SecurityCode</label>
            <input type="password" autocomplete="off" class="txt" name="SecurityCode" id="securityCode" maxlength="6" />
        </div>
        <div class="rowlg">
            <label class="lb-title" for="confirmSecurityCode">@AuthResource.ConfirmSecurityCode</label>
            <input type="password" autocomplete="off" class="txt" name="ConfirmSecurityCode" id="confirmSecurityCode" maxlength="6" />
        </div>
        <div id="message-container">
            @if (Model.Result?.IsFail == true)
            {
                <div class="msg msg-error">@Model.Result.Message</div>
            }
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="buttonCancel" value="@AuthResource.Back" />
            <input type="submit" class="btn-submit" value="@AuthResource.Submit" />
        </div>
    }
</div>
@Html.Hidden("securitycodeToken", Model.SecurityCodeToken)
@Html.Hidden("securitySalt", Model.SecuritySalt)
@Html.Hidden("hashKey", Model.HashKey)
@Html.Hidden("mainRootPath", Model.MainRootPath)
