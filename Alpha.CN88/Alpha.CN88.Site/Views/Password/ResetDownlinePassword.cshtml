@using CN88.Auth.AppResources
@model Alpha.CN88.Site.ViewModels.Password.PasswordViewModel
@{
    Layout = "~/Views/Password/Shared/_Layout.cshtml";
    ViewBag.Title = AuthResource.ResetPassword;
}
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/password/reset-password")
}
<div class="block">
    <div class="title-box">@AuthResource.ResetPassword</div>
    @using (Html.BeginForm("ResetDownlinePassword", "Password", FormMethod.Post, new { id = "formPassword", @class = "form-security form-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("custId", Model.CustId.ToString())
        @Html.Hidden("custName", Model.CustName)
        <div class="rules">
            <p>@AuthResource.PasswordHint01</p>
            <ul>
                @Html.Raw(AuthResource.PasswordHint02)
            </ul>
            @Html.Raw(AuthResource.PasswordHint03)
        </div>
        <div class="rowlg help-rules">
            <label class="lb-title" for="newPassword">@AuthResource.NewPassword</label>
            <input type="password" autocomplete="off" class="txt" name="NewPassword" id="newPassword" maxlength="16" />
        </div>
        <div class="rowlg">
            <label class="lb-title" for="confirmPassword">@AuthResource.ConfirmPassword</label>
            <input type="password" autocomplete="off" class="txt" name="ConfirmPassword" id="confirmPassword" maxlength="16" />
        </div>
        if (Model.Result != null)
        {
            <div id="message-container" class="msg @(Model.Result.IsSuccess ? "msg-success" : "msg-error")">@Model.Result.Message</div>
        }
        else
        {
            <div id="message-container"></div>
        }
        <div class="list-button">
            <input type="button" class="btn-cancel" id="buttonCancel" value="@AuthResource.Cancel" />
            <input type="submit" class="btn-submit" value="@AuthResource.Submit" />
        </div>
    }
</div>
@Html.Hidden("HashKey", Model.HashKey)
