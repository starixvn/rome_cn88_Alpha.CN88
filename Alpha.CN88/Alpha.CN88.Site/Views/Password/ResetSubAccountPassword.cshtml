@using CN88.Auth.AppResources
@model Alpha.CN88.Site.ViewModels.Password.ResetPasswordViewModel
@{
    Layout = "~/Views/Password/Shared/_Layout.cshtml";
    ViewBag.Title = AuthResource.ResetPassword;
}
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/security/change-password")
}
@section Scripts {
    @if (Model.Result?.IsSuccess == true)
    {
        <script type="text/javascript">
            $(function () {
                setTimeout(top.popupManager.close, 3000);
            });
        </script>
    }
    else
    {
        @StaticResources.RenderScripts("~/assets/bundles/password/change-password")
    }
}
<div class="block">
    @using (Html.BeginForm("ResetSubAccountPassword", "Password", FormMethod.Post, new { id = "formPassword", @class = "form-security form-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("custId", Model.CustId.ToString())
        <div class="rules">
            <p><span class="text-red">*</span>@AuthResource.PasswordHint01</p>
            <ul>
                @Html.Raw(AuthResource.PasswordHint02)
            </ul>
            @Html.Raw(AuthResource.PasswordHint03)
        </div>
        <div id="message-container">
            @if (Model.Result != null)
            {
                <div class="msg @(Model.Result.IsSuccess ? "msg-success" : "msg-error")">@Model.Result.Message</div>
            }
        </div>
        <div class="rowlg">
            <label class="lb-title" for="newPassword">@AuthResource.NewPassword <span class="star">*</span></label>
            <input type="password" autocomplete="off" class="txt" name="NewPassword" id="newPassword" maxlength="16" />
        </div>
        <div class="rowlg">
            <label class="lb-title" for="confirmPassword">@AuthResource.ConfirmPassword <span class="star">*</span></label>
            <input type="password" autocomplete="off" class="txt" name="ConfirmPassword" id="confirmPassword" maxlength="16" />
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="buttonCancel" value="@AuthResource.Cancel" />
            <input type="submit" class="btn-submit" value="@AuthResource.Save" />
        </div>
    }
</div>
@Html.Hidden("hashKey", Model.HashKey)
