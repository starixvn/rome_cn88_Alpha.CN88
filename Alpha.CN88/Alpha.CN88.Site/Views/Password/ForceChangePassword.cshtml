@using CN88.Auth.AppResources
@model Alpha.CN88.Site.ViewModels.Password.ForceChangePasswordViewModel
@{
    Layout = "~/Views/Password/Shared/_Layout.cshtml";
    ViewBag.Title = AuthResource.ChangePassword;
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render("/bundles/site-cn88/security/before-home-page")
}
@section Scripts {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-cn88/security/before-home-page")
    @*@StaticResources.RenderScripts("~/assets/bundles/password/force-change-password")*@
}
<div class="block">
    <div class="title-box">Change Password</div>
    @using (Html.BeginForm("ForceChangePassword", "Password", FormMethod.Post, new { id = "pwdForm", @class = "form-force-change-pass form-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("HashKey", Model.HashKey)
        <div class="rules">
            <p>@AuthResource.PasswordHint01</p>
            <ul>
                @Html.Raw(AuthResource.PasswordHint02)
            </ul>
            @Html.Raw(AuthResource.PasswordHint03)
        </div>
        <div class="rowlg">
            <label class="lb-title">@AuthResource.OldPassword</label>
            <input type="password" autocomplete="off" class="txt" name="CurrentPassword" id="txtOldPwd"  maxlength="16" />
            <label id="txtOldPwd-error" class="error"></label>
            @*<i class="icon-lock"></i>
            <i class="validation"></i>*@
        </div>
        <div class="rowlg help-rules">
            <label class="lb-title">@AuthResource.NewPassword</label>
            <input type="password" autocomplete="off" class="txt" name="NewPassword"  id="txtNewPwd" maxlength="16" />
            <label id="txtNewPwd-error" class="error"></label>
            @*<i class="icon-lock"></i>
            <i class="validation"></i>*@
        </div>
        <div class="rowlg">
            <label class="lb-title">@AuthResource.ConfirmPassword</label>
            <input type="password" autocomplete="off" class="txt" name="ConfirmPassword"  id="txtConfirmPwd" maxlength="16" />
            <label id="txtConfirmPwd-error" class="error"></label>
            @*<i class="icon-lock"></i>
            <i class="validation"></i>*@
        </div>
        @*<div class="rowlg">
            <label><input type="checkbox" id="showPasswordchk" />@AuthResource.ShowPassword</label>
        </div>*@
        <div class="list-button">
            <input type="button" class="btn-cancel" id="btn-back" value="@AuthResource.Back" />
            <input type="submit" class="btn-submit" value="@AuthResource.Submit" />
        </div>
    }
</div>
