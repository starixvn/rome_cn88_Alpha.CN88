@using CN88.Auth.AppResources
@model Alpha.CN88.Site.ViewModels.Password.ForceChangePasswordViewModel
@{
    Layout = "~/Views/Password/Shared/_Layout.cshtml";
    ViewBag.Title = AuthResource.ChangePassword;
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render("/bundles/site-main/security/before-home-page")
}
@section Scripts {
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.Render("/bundles/site-main/security/before-home-page")
    @*@StaticResources.RenderScripts("~/assets/bundles/password/force-change-password")*@
}
<div class="block">
    @using (Html.BeginForm("ForceChangePassword", "Password", FormMethod.Post, new { id = "pwdForm", @class = "form-SC form-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("HashKey", Model.HashKey)
        <div class="rowlg">
            <input type="password" autocomplete="off" class="txt" name="CurrentPassword" id="txtOldPwd" placeholder="@AuthResource.OldPassword" maxlength="16" />
            <label id="txtOldPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg help-rules">
            <input type="password" autocomplete="off" class="txt" name="NewPassword" placeholder="@AuthResource.NewPassword" id="txtNewPwd" maxlength="16" />
            <label id="txtNewPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg">
            <input type="password" autocomplete="off" class="txt" name="ConfirmPassword" placeholder="@AuthResource.ConfirmPassword" id="txtConfirmPwd" maxlength="16" />
            <label id="txtConfirmPwd-error" class="error"></label>
            <i class="icon-lock"></i>
            <i class="validation"></i>
        </div>
        <div class="rowlg">
            <label><input type="checkbox" id="showPasswordchk" />@AuthResource.ShowPassword</label>
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="btn-back" value="@AuthResource.Back" />
            <input type="submit" class="btn-submit" value="@AuthResource.Submit" />
        </div>
    }
    <div class="rules" id="rules">
        <div class="rules-title" id="rules-title" data-toggle="modal" data-target="#pwd"><span class="icon-information-outline icon-rules"></span>@AuthResource.PasswordRules</div>
        <!-- Modal -->
        <div class="modal fade information" id="pwd" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <span class="icon icon-close close" data-dismiss="modal" aria-label="Close"></span>
                        <h4 class="modal-title" id="myModalLabel"><span class="icon-information-outline icon-rules"></span>@AuthResource.PasswordRules</h4>
                    </div>
                    <div class="modal-body">
                        <p>@AuthResource.PasswordHint01</p>
                        <ul>
                            @Html.Raw(AuthResource.PasswordHint02)
                        </ul>
                        @Html.Raw(AuthResource.PasswordHint03)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
