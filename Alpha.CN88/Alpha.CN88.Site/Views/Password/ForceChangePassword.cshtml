@using CN88.Auth.AppResources
@model Alpha.CN88.Site.ViewModels.Password.ChangePasswordViewModel
@{
    Layout = "~/Views/Password/Shared/_Layout.cshtml";
    ViewBag.Title = AuthResource.ChangePassword;
    @StaticResources.RenderStyles("~/assets/bundles/security/force-change-pass")
}

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/password/change-password")
}
<div class="block">
    <div class="title-box">@AuthResource.ChangePassword</div>
    @using (Html.BeginForm("ForceChangePassword", "Password", FormMethod.Post, new { id = "formPassword", @class = "form-security form-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        <div class="rules">
            <p>@AuthResource.PasswordHint01</p>
            <ul>
                @Html.Raw(AuthResource.PasswordHint02)
            </ul>
            @Html.Raw(AuthResource.PasswordHint03)
        </div>
        <div class="rowlg">
            <label class="lb-title" for="currentPassword">@AuthResource.OldPassword</label>
            <input type="password" autocomplete="off" class="txt" name="CurrentPassword" id="currentPassword" maxlength="16" />
        </div>
        <div class="rowlg help-rules">
            <label class="lb-title" for="newPassword">@AuthResource.NewPassword</label>
            <input type="password" autocomplete="off" class="txt" name="NewPassword" id="newPassword" maxlength="16" />
        </div>
        <div class="rowlg">
            <label class="lb-title" for="confirmPassword">@AuthResource.ConfirmPassword</label>
            <input type="password" autocomplete="off" class="txt" name="ConfirmPassword" id="confirmPassword" maxlength="16" />
        </div>
        <div id="message-container">
            @if (Model.Result?.IsFail == true)
            {
                <div id="message-container" class="msg msg-error">@Model.Result.Message</div>
            }
        </div>
        <div class="list-button">
            <input type="button" class="btn-cancel" id="buttonCancel" value="@AuthResource.Back" />
            <input type="submit" class="btn-submit" value="@AuthResource.Submit" />
        </div>
    }
</div>
@Html.Hidden("hashKey", Model.HashKey)
@Html.Hidden("mainRootPath", Model.MainRootPath)
