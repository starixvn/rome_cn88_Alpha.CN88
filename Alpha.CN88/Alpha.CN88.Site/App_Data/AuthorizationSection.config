<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D]"
  custIdQueryStringParamNameMapping="custid,customerid"
  custIdJsonParamNameMapping=""
  cachedExpireTime="30"
  kickOutUrl="~/auth/kickout">
  <!--
    [A]: Total Bets
    [B]: Account Management View Only
    [C]: Account Management Edit & View
    [D]: Reports
  -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[B]" mainfuncname="Password" subfuncname="Reset Downline Password" url="Password/ResetDownlinePassword" ischeckbelonging="true" />
      <add id="1.02.01" permission="[B]" mainfuncname="Security Code" subfuncname="Reset Downline Security Code" url="SecurityCode/ResetSecurityCode" ischeckbelonging="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>