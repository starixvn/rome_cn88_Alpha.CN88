<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[B],[D],[E],[H]"
  custIdQueryStringParamNameMapping="custid,customerid"
  custIdJsonParamNameMapping=""
  cachedExpireTime="30"
  kickOutUrl="~/auth/kickout">
  <!--
    [B]: Account Management Edit & View
    [D]: Total Bets
    [E]: Reports
    [H]: Account Management View Only
  -->
  <GroupPageAccess roleid="2" name="Agent">   
    <PageAccesses>
      <add id="1.01.01" permission="[H],[B]" mainfuncname="Password" subfuncname="Reset Downline Password" url="Password/ResetDownlinePassword" ischeckbelonging="true" ischeckaccountstatus="true" />
      <add id="1.01.02" permission="[Z]" mainfuncname="Password" subfuncname="Reset Sub-Account Password" url="Password/ResetSubAccountPassword" ischeckbelonging="false" ischeckaccountstatus="true" />
      <add id="1.02.01" permission="[H],[B]" mainfuncname="Security Code" subfuncname="Reset Downline Security Code" url="SecurityCode/ResetSecurityCode" ischeckbelonging="true" ischeckaccountstatus="true" />
      <add id="1.02.02" permission="[Z]" mainfuncname="Security Code" subfuncname="Reset Sub-Account Security Code" url="SecurityCode/ResetSubAccountSecurityCode" ischeckbelonging="false" ischeckaccountstatus="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>