<?xml version="1.0" encoding="utf-8" ?>
<siteMap xmlns="http://schemas.microsoft.com/AspNet/SiteMap-File-1.0" enableLocalization="true">
  <siteMapNode title="Alpha CN88 Site">
    <siteMapNode resourceKey="home" appPath="CN88AppPath" url="Home/Index" roles="4,3,2"></siteMapNode>
    <siteMapNode resourceKey="announcement" appPath="MessageAppPath" url="MessageHistory/Index?messageType=0"></siteMapNode>
    <siteMapNode resourceKey="totalBets" menuItemType="TotalBetsMenuItem" functionType="[D]" roles="4,3,2">
      <siteMapNode resourceKey="overview" appPath="TotalBetAppPath" url="Overview/Index"></siteMapNode>
      <siteMapNode resourceKey="inplay" appPath="TotalBetAppPath" url="TotalBets/InPlay"></siteMapNode>
      <siteMapNode resourceKey="today" appPath="TotalBetAppPath" url="TotalBets/Today"></siteMapNode>
      <siteMapNode resourceKey="early" appPath="TotalBetAppPath" url="TotalBets/Early"></siteMapNode>
      <siteMapNode resourceKey="started" appPath="TotalBetAppPath" url="TotalBets/Started"></siteMapNode>
      <siteMapNode resourceKey="parlay" appPath="TotalBetAppPath" url="TotalBets/Parlay"></siteMapNode>
      <siteMapNode resourceKey="outright" appPath="TotalBetAppPath" url="Outright/Index"></siteMapNode>
      <siteMapNode resourceKey="results" appPath="ResultSiteVirtualPath" url="TotalBets/Results"></siteMapNode>
      <!--<siteMapNode resourceKey="wagerMonitoringConsole" appPath="CN88AppPath" isBeta="true" url="TotalBets/WagerMonitoringConsole"></siteMapNode>-->
    </siteMapNode>
    <siteMapNode resourceKey="accountManagement" menuItemType="AccountManagementMenuItem" functionType="[B][H]" roles="4,3,2">
      <siteMapNode resourceKey="downlineList" appPath="FeaturesAppPath" url="CustomerList/Index" roles=""></siteMapNode>
      <siteMapNode resourceKey="subAccount" menuItemType="SubAccountMenuItem" appPath="FeaturesAppPath" url="SubAccount/Index" roles="None"></siteMapNode>
      <siteMapNode resourceKey="problemAccount" appPath="FeaturesAppPath" url="AccountManagement/ProblemAccount" roles="None"></siteMapNode>
      <siteMapNode resourceKey="viewLog" appPath="ViewLogAppPath" url="Setting"></siteMapNode>
    </siteMapNode>
    <siteMapNode resourceKey="reports" menuItemType="ReportMenuItem" functionType="[E]" roles="">
      <siteMapNode resourceKey="wagerReport" appPath="FeaturesAppPath" url="Reports/Index?DisplayMode=1"></siteMapNode>
      <siteMapNode resourceKey="legacyReport" appPath="FeaturesAppPath" url="Reports/Index?DisplayMode=2"></siteMapNode>
      <siteMapNode resourceKey="oldReport" appPath="FeaturesAppPath" url="javascript:void(0);"></siteMapNode>
    </siteMapNode>
    <siteMapNode resourceKey="help" roles="None">
      <siteMapNode resourceKey="newUrl" appPath="CN88AppPath" url="Help/NewUrl"></siteMapNode>
      <siteMapNode resourceKey="troubleshooting" appPath="CN88AppPath" url="Help/Troubleshooting"></siteMapNode>
    </siteMapNode>
  </siteMapNode>
</siteMap>